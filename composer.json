{
    "name":         "restcord/restcord",
    "description":  "REST Library for the Discord API",
    "type":         "library",
    "extra": {
        "discord-openapi": {
            "repository": "discord/discord-api-spec",
            "path": "specs/openapi.json",
            "commit": "4e5c3dbe385cc148dde582325314e598fddbd7a9",
            "sha256": "49efa428e0dd5babf5527aa3046e2d29d0c3d9daef2c7100c2619cb440c57cf6"
        }
    },
    "require":      {
        "php":                   "^8.3",
        "guzzlehttp/guzzle":     "^8.1",
        "guzzlehttp/promises":   "^3.0.2",
        "psr/http-message":      "^2.0",
        "psr/log":               "^3.0",
        "composer-runtime-api":  "^2.2"
    },
    "autoload":     {
        "psr-4": {
            "RestCord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RestCord\\Tests\\": "tests/"
        }
    },
    "license":      "MIT",
    "suggest": {
        "ext-redis": "Required by RedisRateLimitProvider."
    },
    "authors":      [
        {
            "name":  "Aaron Scherer",
            "email": "aequasi@gmail.com"
        }
    ],
    "require-dev":  {
        "phpunit/phpunit": "^12.5"
    }
}
